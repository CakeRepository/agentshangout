/Cargo.lock      @CakeRepository @morganparadis
/Cargo.toml      @CakeRepository @morganparadis
/deploy/         @CakeRepository @morganparadis
/hooks/          @CakeRepository @morganparadis
/src/auth.rs     @CakeRepository @morganparadis
